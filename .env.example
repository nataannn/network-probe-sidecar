# Copy to .env and adjust. These are operational settings only - no
# credentials are needed for this sidecar.

OUTPUT_DIR=/data/probes
TARGETS_FILE=/app/config/targets.yaml

INTERVAL_SECONDS=30

PING_COUNT=4
PING_TIMEOUT_SECONDS=5

TRACEROUTE_MAX_HOPS=20
TRACEROUTE_TIMEOUT_SECONDS=2
TRACEROUTE_PROBES_PER_HOP=1

# How many targets to probe in parallel. Keep this >= number of targets so
# a full cycle comfortably fits inside INTERVAL_SECONDS.
MAX_WORKERS=8

# Keep raw ping/traceroute stdout alongside the parsed fields (useful for
# debugging parsing issues; costs a bit more disk space).
INCLUDE_RAW_OUTPUT=true

LOG_LEVEL=INFO

# Port exposed by the Prometheus exporter (network-probe-exporter service).
EXPORTER_PORT=9200
